<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Create Game Wizard Form -->
    <record id="view_chess_create_game_form" model="ir.ui.view">
        <field name="name">chess.create.game.form</field>
        <field name="model">chess.create.game</field>
        <field name="arch" type="xml">
            <form string="Create Chess Game">
                <group>
                    <group>
                        <field name="game_type" widget="radio"/>
                    </group>
                </group>
                <group>
                    <group string="Opponent">
                        <field name="opponent_id"
                               invisible="game_type != 'human'"
                               required="game_type == 'human'"
                               options="{'no_create': True}"
                               domain="[('share', '=', False), ('id', '!=', uid), ('all_group_ids', 'in', [%(odoo_chess.group_chess_user)d])]"/>
                        <field name="bot_key"
                               invisible="game_type != 'bot'"
                               required="game_type == 'bot'"/>
                    </group>
                    <group string="Settings">
                        <field name="play_as" widget="radio"/>
                    </group>
                </group>
                <group>
                    <group string="Time Control">
                        <field name="time_control_type" widget="radio"/>
                        <field name="time_control_preset"
                               invisible="time_control_type not in ('bullet', 'blitz', 'rapid', 'classical')"
                               required="time_control_type in ('bullet', 'blitz', 'rapid', 'classical')"/>
                        <field name="base_time_minutes"
                               invisible="time_control_type != 'custom'"
                               required="time_control_type == 'custom'"/>
                        <field name="increment_seconds"
                               invisible="time_control_type != 'custom'"/>
                    </group>
                </group>
                <group>
                    <field name="reward_text" placeholder="e.g., Loser buys coffee..."/>
                    <field name="message" invisible="game_type != 'human'"
                           placeholder="Add a message to your challenge..."/>
                </group>
                <footer>
                    <button name="action_create_game" string="Create Game" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_chess_create_game" model="ir.actions.act_window">
        <field name="name">New Chess Game</field>
        <field name="res_model">chess.create.game</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
