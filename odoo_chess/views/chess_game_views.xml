<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action for Game Moves (must be defined before form view that references it) -->
    <record id="action_chess_game_moves" model="ir.actions.act_window">
        <field name="name">Game Moves</field>
        <field name="res_model">chess.move</field>
        <field name="view_mode">list</field>
        <field name="domain">[('game_id', '=', active_id)]</field>
        <field name="context">{'default_game_id': active_id}</field>
    </record>

    <!-- Chess Game Form View -->
    <record id="view_chess_game_form" model="ir.ui.view">
        <field name="name">chess.game.form</field>
        <field name="model">chess.game</field>
        <field name="arch" type="xml">
            <form string="Chess Game" create="false">
                <header>
                    <button name="action_resign" string="Resign"
                            type="object" class="btn-danger"
                            invisible="state != 'active' or my_color == 'spectator'"
                            confirm="Are you sure you want to resign?"/>
                    <button name="action_offer_draw" string="Offer Draw"
                            type="object" class="btn-warning"
                            invisible="state != 'active' or my_color == 'spectator' or draw_offered_by"/>
                    <button name="action_accept_draw" string="Accept Draw"
                            type="object" class="btn-success"
                            invisible="state != 'active' or not draw_offered_by or draw_offered_by == uid"/>
                    <button name="action_decline_draw" string="Decline Draw"
                            type="object" class="btn-secondary"
                            invisible="state != 'active' or not draw_offered_by or draw_offered_by == uid"/>
                    <button name="action_claim_draw" string="Claim Draw"
                            type="object" class="btn-info"
                            invisible="state != 'active' or not can_claim_draw"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not draw_offered_by">
                        <strong>Draw Offered!</strong>
                        <field name="draw_offered_by" readonly="1"/> has offered a draw.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not is_check or state != 'active'">
                        <strong>Check!</strong>
                    </div>
                    <group>
                        <group string="Players">
                            <field name="white_player_id" readonly="1"/>
                            <field name="black_player_id" readonly="1"/>
                            <field name="current_player_id" readonly="1"
                                   invisible="state != 'active'"/>
                            <field name="my_color" invisible="1"/>
                            <field name="is_my_turn" invisible="1"/>
                        </group>
                        <group string="Game Info">
                            <field name="result" readonly="1" invisible="state != 'completed'"/>
                            <field name="result_reason" readonly="1" invisible="state != 'completed'"/>
                            <field name="winner_id" readonly="1" invisible="state != 'completed' or result == 'draw'"/>
                            <field name="is_bot_game" readonly="1"/>
                            <field name="bot_key" invisible="not is_bot_game" readonly="1"/>
                            <field name="is_timed" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="not is_timed">
                        <group string="Time Control">
                            <field name="time_control_display" readonly="1"/>
                            <field name="white_time_display" readonly="1" string="White Clock"/>
                            <field name="black_time_display" readonly="1" string="Black Clock"/>
                        </group>
                    </group>

                    <!-- Chessboard Widget - Full width, outside of group -->
                    <div class="o_chess_section" invisible="state == 'cancelled'">
                        <h3 class="mt-3 mb-3">Chess Board</h3>
                        <field name="fen" widget="chess_board" nolabel="1"/>
                    </div>

                    <group string="Stakes" invisible="not reward_text">
                        <field name="reward_text" readonly="1" nolabel="1"/>
                    </group>

                    <notebook invisible="state == 'cancelled'">
                        <page string="Move History" name="moves">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="san"/>
                                    <field name="player_display"/>
                                    <field name="timestamp"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group>
                                <field name="fen" readonly="1"/>
                                <field name="pgn" readonly="1"/>
                                <field name="last_move_uci" readonly="1"/>
                                <field name="last_activity" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Chess Game List View -->
    <record id="view_chess_game_list" model="ir.ui.view">
        <field name="name">chess.game.list</field>
        <field name="model">chess.game</field>
        <field name="arch" type="xml">
            <list string="Chess Games" default_order="create_date desc" create="false">
                <field name="name"/>
                <field name="white_player_id"/>
                <field name="black_player_id"/>
                <field name="time_control_display" optional="show"/>
                <field name="state" decoration-info="state == 'pending'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'completed'"
                       decoration-danger="state == 'cancelled'"
                       widget="badge"/>
                <field name="result" invisible="state != 'completed'"/>
                <field name="move_count"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Chess Game Search View -->
    <record id="view_chess_game_search" model="ir.ui.view">
        <field name="name">chess.game.search</field>
        <field name="model">chess.game</field>
        <field name="arch" type="xml">
            <search string="Search Games">
                <field name="name"/>
                <field name="white_player_id"/>
                <field name="black_player_id"/>
                <filter string="My Games" name="my_games"
                        domain="['|', ('white_player_id', '=', uid), ('black_player_id', '=', uid)]"/>
                <filter string="My Turn" name="my_turn"
                        domain="[('current_player_id', '=', uid), ('state', '=', 'active')]"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="vs Bot" name="bot_games" domain="[('is_bot_game', '=', True)]"/>
                <filter string="vs Human" name="human_games" domain="[('is_bot_game', '=', False)]"/>
                <separator/>
                <filter string="Timed" name="timed_games" domain="[('is_timed', '=', True)]"/>
                <filter string="Untimed" name="untimed_games" domain="[('is_timed', '=', False)]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}"/>
                    <filter string="White Player" name="group_white" context="{'group_by': 'white_player_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Action -->
    <record id="action_chess_games" model="ir.actions.act_window">
        <field name="name">My Chess Games</field>
        <field name="res_model">chess.game</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_games': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No chess games yet!
            </p>
            <p>
                Go to <b>Chess &gt; Play &gt; New Game</b> to start a new chess game.
            </p>
        </field>
    </record>

    <!-- All Games Action (for managers) -->
    <record id="action_chess_games_all" model="ir.actions.act_window">
        <field name="name">All Chess Games</field>
        <field name="res_model">chess.game</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No chess games in the system yet.
            </p>
        </field>
    </record>

</odoo>
