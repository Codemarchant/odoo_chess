<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Chess Invitation Form View -->
    <record id="view_chess_invitation_form" model="ir.ui.view">
        <field name="name">chess.invitation.form</field>
        <field name="model">chess.invitation</field>
        <field name="arch" type="xml">
            <form string="Chess Invitation" create="false">
                <header>
                    <button name="action_accept" string="Accept Challenge"
                            type="object" class="btn-success"
                            invisible="state != 'pending' or invitee_id != uid"/>
                    <button name="action_decline" string="Decline"
                            type="object" class="btn-danger"
                            invisible="state != 'pending' or invitee_id != uid"/>
                    <button name="action_cancel" string="Cancel Invitation"
                            type="object" class="btn-secondary"
                            invisible="state != 'pending' or inviter_id != uid"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,accepted,declined"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Chess Challenge</h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'pending'">
                        <strong><field name="inviter_id" readonly="1"/></strong>
                        has challenged
                        <strong><field name="invitee_id" readonly="1"/></strong>
                        to a chess game!
                    </div>
                    <group>
                        <group string="Challenge Details">
                            <field name="inviter_id" readonly="1"/>
                            <field name="invitee_id" readonly="1"/>
                            <field name="color_choice" readonly="1"/>
                        </group>
                        <group string="Game" invisible="not game_id">
                            <field name="game_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Stakes" invisible="not reward_text">
                        <field name="reward_text" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Message" invisible="not message">
                        <field name="message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Chess Invitation List View -->
    <record id="view_chess_invitation_list" model="ir.ui.view">
        <field name="name">chess.invitation.list</field>
        <field name="model">chess.invitation</field>
        <field name="arch" type="xml">
            <list string="Chess Invitations" create="false">
                <field name="inviter_id"/>
                <field name="invitee_id"/>
                <field name="color_choice"/>
                <field name="state" decoration-info="state == 'pending'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state in ('declined', 'cancelled')"
                       widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Chess Invitation Search View -->
    <record id="view_chess_invitation_search" model="ir.ui.view">
        <field name="name">chess.invitation.search</field>
        <field name="model">chess.invitation</field>
        <field name="arch" type="xml">
            <search string="Search Invitations">
                <field name="inviter_id"/>
                <field name="invitee_id"/>
                <filter string="Received" name="received"
                        domain="[('invitee_id', '=', uid)]"/>
                <filter string="Sent" name="sent"
                        domain="[('inviter_id', '=', uid)]"/>
                <separator/>
                <filter string="Pending" name="pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Accepted" name="accepted"
                        domain="[('state', '=', 'accepted')]"/>
                <group>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Inviter" name="group_inviter"
                            context="{'group_by': 'inviter_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Invitations -->
    <record id="action_chess_invitations" model="ir.actions.act_window">
        <field name="name">My Invitations</field>
        <field name="res_model">chess.invitation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('inviter_id', '=', uid), ('invitee_id', '=', uid)]</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No chess invitations!
            </p>
            <p>
                Challenge someone to a chess game to see invitations here.
            </p>
        </field>
    </record>

</odoo>
