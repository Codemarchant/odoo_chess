<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default Chess Bots -->
        <record id="chess_bot_random" model="chess.bot">
            <field name="name">Random Randy</field>
            <field name="difficulty">random</field>
            <field name="rating">600</field>
            <field name="description">Makes completely random moves. Great for beginners or testing!</field>
        </record>

        <record id="chess_bot_easy" model="chess.bot">
            <field name="name">Beginner Bot</field>
            <field name="difficulty">easy</field>
            <field name="rating">800</field>
            <field name="description">A gentle opponent that looks only one move ahead. Perfect for learning!</field>
        </record>

        <record id="chess_bot_medium" model="chess.bot">
            <field name="name">Casual Carl</field>
            <field name="difficulty">medium</field>
            <field name="rating">1200</field>
            <field name="description">A moderate challenge - plans two moves ahead and watches for basic tactics.</field>
        </record>

        <record id="chess_bot_hard" model="chess.bot">
            <field name="name">Strategic Steve</field>
            <field name="difficulty">hard</field>
            <field name="rating">1500</field>
            <field name="description">A formidable opponent with deeper calculation. Beware of tactical traps!</field>
        </record>

    </data>
</odoo>
